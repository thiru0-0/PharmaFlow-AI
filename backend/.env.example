# Copy to backend/.env and fill in. The app runs in demo mode with NONE of the
# external integrations configured (SQLite fallback, mock notifications, schematic map).

APP_ENV=demo

# --- Database -------------------------------------------------------------------
# PostgreSQL (recommended, matches the build spec):
#   DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/pharmaflow
# Leave unset to use a local SQLite file (backend/pharmaflow_dev.db).
DATABASE_URL=

# --- Auth ----------------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALG=HS256
JWT_EXPIRE_MINUTES=720

# --- Business rules (configurable — not hardcoded regulatory numbers) ----------
EXPIRY_ALERT_DAYS=60
QTY_TOLERANCE_PCT=2.0
QTY_TOLERANCE_MIN_UNITS=2
RETAILER_RETURN_WINDOW_DAYS=30
MANUFACTURER_DISPOSAL_WINDOW_DAYS=30

# --- Optional external integrations (all mocked when blank) -------------------
MAPBOX_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMS_PROVIDER_URL=

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
